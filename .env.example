OPENROUTER_API_KEY=

# Optional. Firecrawl is the preferred scraper (1,000 free credits a month at firecrawl.dev).
# Without it, Decision Desk falls back to the keyless Jina Reader.
FIRECRAWL_API_KEY=
# Optional. Raises the Jina Reader rate limit when Firecrawl is not configured.
JINA_API_KEY=
# Optional. Raises GitHub's anonymous limit of 60 requests an hour to 5,000.
GITHUB_TOKEN=
# Optional. OpenRouter model that analyzes sources and writes tailored prompts.
ANALYSIS_MODEL=anthropic/claude-sonnet-5.5
